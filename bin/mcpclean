#!/usr/bin/env bash
# mcpclean - find and stop stale Claude sessions + orphaned MCP servers.
# Dry run by default. Never touches the session it is run from.
#
#   mcpclean            list what would be stopped
#   mcpclean --kill     stop it
#   mcpclean --dev      also include expo / vitest / vite dev servers
#   MAX_AGE_H=6 mcpclean   change stale threshold (default 12 hours)

set -u
MAX_AGE_H="${MAX_AGE_H:-12}"
DO_KILL=0
DEV=0
for a in "$@"; do
  case "$a" in
    --kill) DO_KILL=1 ;;
    --dev) DEV=1 ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
  esac
done

targets=$(ps -axo pid=,ppid=,etime=,rss=,command= | awk -v self=$$ -v maxh="$MAX_AGE_H" -v dev="$DEV" '
function secs(e,   d,p,n,s) {
  d = 0
  if (index(e, "-")) { split(e, p, "-"); d = p[1]; e = p[2] }
  n = split(e, p, ":")
  if (n == 3) s = p[1]*3600 + p[2]*60 + p[3]
  else        s = p[1]*60 + p[2]
  return d*86400 + s
}
function is_claude(c,   b) {
  split(c, f, " "); b = f[1]; sub(/.*\//, "", b)
  return (b == "claude")
}
{
  pid = $1; ppid[pid] = $2; age[pid] = secs($3); rss[pid] = $4
  cmd = $0; sub(/^ *[0-9]+ +[0-9]+ +[^ ]+ +[0-9]+ +/, "", cmd); c[pid] = cmd
  order[++n] = pid
}
END {
  # protect: self ancestors, nearest claude ancestor and its descendants
  prot_root = ""
  for (p = self; p > 1 && p != ""; p = ppid[p]) {
    prot[p] = 1
    if (prot_root == "" && is_claude(c[p])) prot_root = p
  }
  if (prot_root != "") {
    changed = 1
    prot[prot_root] = 1
    while (changed) {
      changed = 0
      for (i = 1; i <= n; i++) { q = order[i]
        if (!(q in prot) && (ppid[q] in prot)) { prot[q] = 1; changed = 1 }
      }
    }
  }

  mcp_re = "argent|/rea mcp|chrome-devtools-mcp|openmotion/run-mcp|openmotion/apps/.*/mcp\\.ts|mcp-selenium|playwright-mcp|mcp-remote|MCP Magic/mcp-server"
  dev_re = "expo run:|expo start|vitest|/vite( |$)"

  # stale claude sessions
  for (i = 1; i <= n; i++) { q = order[i]
    if (q in prot) continue
    if (is_claude(c[q]) && age[q] > maxh*3600) stale[q] = 1
  }

  for (i = 1; i <= n; i++) { q = order[i]
    if (q in prot) continue
    kind = ""
    if (q in stale) kind = "claude-session"
    else if (c[q] ~ mcp_re && c[q] !~ /Antigravity/) {
      # nearest claude ancestor (if any)
      owner = ""
      for (a = ppid[q]; a > 1 && a != ""; a = ppid[a])
        if (is_claude(c[a])) { owner = a; break }
      # no Claude owner: orphan only if the top of its chain is itself an MCP/npm
      # wrapper. If the top is an app (Antigravity, Claude Desktop, Cursor...), it is live.
      r = q
      while (ppid[r] > 1 && (ppid[r] in c)) r = ppid[r]
      wrapper = (c[r] ~ mcp_re || c[r] ~ /npm exec|npx /)
      if ((owner == "" && wrapper) || (owner in stale)) kind = "mcp-orphan"
    }
    else if (dev && c[q] ~ dev_re) kind = "dev-server"
    if (kind != "") printf "%s\t%s\t%d\t%d\t%s\n", q, kind, age[q], rss[q]/1024, substr(c[q], 1, 90)
  }
}')

if [ -z "$targets" ]; then
  echo "nothing stale"
  exit 0
fi

printf '%-7s %-15s %-8s %-6s %s\n' PID KIND AGE MB CMD
echo "$targets" | while IFS=$'\t' read -r pid kind age mb cmd; do
  h=$((age/3600)); m=$(((age%3600)/60))
  printf '%-7s %-15s %-8s %-6s %s\n' "$pid" "$kind" "${h}h${m}m" "$mb" "$cmd"
done

count=$(echo "$targets" | wc -l | tr -d ' ')
total=$(echo "$targets" | awk -F'\t' '{s+=$4} END{print s}')
echo "-- $count processes, ~${total}MB"

if [ "$DO_KILL" -ne 1 ]; then
  echo "dry run. rerun with --kill to stop them."
  exit 0
fi

pids=$(echo "$targets" | cut -f1)
kill $pids 2>/dev/null
sleep 2
left=""
for p in $pids; do kill -0 "$p" 2>/dev/null && left="$left $p"; done
[ -n "$left" ] && { kill -9 $left 2>/dev/null; echo "force-killed:$left"; }

# second pass: MCP children orphaned by the sessions just stopped
if [ -z "${MCPCLEAN_PASS2:-}" ]; then
  sleep 1
  extra=(--kill); [ "$DEV" -eq 1 ] && extra+=(--dev)
  MCPCLEAN_PASS2=1 "$0" "${extra[@]}"
fi
